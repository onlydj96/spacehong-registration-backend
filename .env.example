PORT=4000
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# Admin email whitelist (comma-separated)
# Users with these emails can access admin panel
ADMIN_EMAILS=admin@example.com,manager@example.com

# Development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Production - add your Vercel domain (comma-separated)
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://spaceghong-registration.vercel.app
# Resend
RESEND_API_KEY=re_your_api_key
# 발신 이메일 주소 (Resend에서 도메인 인증 후 사용)
RESEND_FROM_EMAIL=Space Hong <noreply@space-hong.com>
# 문의/연락 이메일 (PDF·이메일 본문 노출용)
CONTACT_EMAIL=Operator.Spacehong@gmail.com

# Telegram Bot (이메일 발송 실패 알림용)
# 1. @BotFather 에서 봇 생성 후 토큰 발급
# 2. 봇과 직접 대화 시작 후 아래 URL로 chat_id 확인:
#    https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/getUpdates
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
